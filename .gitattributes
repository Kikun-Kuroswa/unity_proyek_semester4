# Auto detect text files and perform LF normalization
* text=auto

# Specify text files
*.cs text diff=csharp
*.cginc text
*.shader text

# Unity YAML files (forces them to be treated nicely by Git)
*.mat text eol=lf
*.anim text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.physicsMaterial2D text eol=lf
*.physicMaterial text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.controller text eol=lf

# Binary files (Git shouldn't try to read these as text)
*.dll binary
*.png binary
*.jpg binary
*.fbx binary
*.wav binary